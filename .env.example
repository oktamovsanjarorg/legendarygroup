# ==============================================================================
# Legendary Group — Lokal muhit oʻzgaruvchilari (.env.example)
# ==============================================================================
# Ushbu fayldan nusxa olib `.env` nomli fayl yarating:
#   cp .env.example .env
#
# Eslatma: Hech qachon haqiqiy sirlarni (secret) git omboriga yuklamang!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Asosiy dastur parametrlari (Node.js & Muhit)
# ------------------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Tashkent

# Ilova portlari (Lokal test uchun)
PORT=3000                 # apps/api HTTP porti
WORKER_PORT=3001          # apps/worker: Bull Board (/queues), faqat ichki tarmoq
BOT_PORT=3002             # apps/bot: webhook serveri (staging/prod)
PORT_WEB=5173             # apps/web Vite dev porti
PORT_MINIAPP=5174          # apps/miniapp Vite dev porti

# ------------------------------------------------------------------------------
# 2. Maʼlumotlar bazasi (PostgreSQL)
# ------------------------------------------------------------------------------
# Port 5434 qilingan, chunki mahalliy tizimda 5432/5433 band boʻlishi mumkin.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legendary_dev

# Drizzle ORM va servislar ulanishi uchun toʻliq ulanish satri (URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/legendary_dev

# ------------------------------------------------------------------------------
# 3. Kesh va navbatlar (Redis / Valkey)
# ------------------------------------------------------------------------------
# Port 6380 qilingan, chunki mahalliy tizimda 6379 band boʻlishi mumkin.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ------------------------------------------------------------------------------
# 4. Fayllar xotirasi (MinIO — AWS S3 lokal emulyatori)
# ------------------------------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_FILES=lg-local-files
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. Xavfsizlik va Autentifikatsiya (JWT & Seanslar)
# ------------------------------------------------------------------------------
# Lokal muhit uchun tasodifiy test kalitlari:
JWT_ACCESS_SECRET=dev_jwt_access_secret_32_characters_minimum_key!
# Refresh token - tasodifiy (opaque), DB'da faqat SHA-256 hash; alohida sir kerak emas.
# TOTP sirlarini shifrlash kaliti (AES-256-GCM, 32 bayt hex):
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Token muddatlari kodda qat'iy (FR-AUTH-4): access 15 daq, refresh 30 kun.

# ------------------------------------------------------------------------------
# 6. Telegram Bot & Mini App
# ------------------------------------------------------------------------------
# Lokal — polling, staging/prod — webhook (Caddy: /bot/webhook)
BOT_MODE=polling
# BotFather bergan dev bot tokeni (har muhit uchun alohida bot)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_dev_dummy
TELEGRAM_BOT_USERNAME=legendary_dev_bot
TELEGRAM_BOT_WEBHOOK_SECRET=dev_webhook_secret_for_validation

# Mini App URL (lokal Vite dev serveri)
TELEGRAM_MINIAPP_URL=http://localhost:5174

# Web panel manzili — CLI taklif havolasi uchun (pnpm cli director:create)
PUBLIC_APP_URL=http://localhost:5173

# Bot -> API ichki chaqiruvlari (/internal/*), faqat Docker tarmog'i ichida (03 §2)
INTERNAL_API_TOKEN=dev_internal_api_token_32_characters_min!

# ------------------------------------------------------------------------------
# 7. Kuzatuvchanlik, Loglar va CORS
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Sentry DSN (Lokal muhitda ixtiyoriy, boʻsh qoldirilishi mumkin)
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 8. Navbatlar (BullMQ) va worker
# ------------------------------------------------------------------------------
QUEUE_PREFIX=lg
# Bull Board (http://localhost:3001/queues) — basic auth; worker ularsiz ishga tushmaydi
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=dev_bull_board_password_change_me
