{
  "name": "@lg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run -c vitest.int.config.ts",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "cli": "tsx --conditions=development src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-presigned-post": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@bull-board/api": "9.11.0",
    "@bull-board/fastify": "9.11.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/static": "10.1.9",
    "@lg/contracts": "workspace:*",
    "@lg/db": "workspace:*",
    "@lg/domain": "workspace:*",
    "@lg/i18n": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "6.6.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "file-type": "22.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "otpauth": "9.6.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lg/config": "workspace:*",
    "@nestjs/testing": "12.3.3",
    "pino-pretty": "13.2.0"
  }
}
