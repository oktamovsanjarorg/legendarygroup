---
import { siteMessages as s } from '@lg/i18n';
import { PALETTE, toCssVariables } from '@lg/ui-core';
import '../styles.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
// Panel bilan bir xil palitra (T-017b); tizim temasi bo'yicha.
const themeCss = `:root{${toCssVariables(PALETTE.light)}}@media (prefers-color-scheme: dark){:root{${toCssVariables(PALETTE.dark)}}}`;
---

<!doctype html>
<html lang="uz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uz_UZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={PALETTE.light.primary} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline set:html={themeCss} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-bg focus:px-4 focus:py-2"
      >{s.skipToContent}</a
    >
    <slot />
  </body>
</html>
