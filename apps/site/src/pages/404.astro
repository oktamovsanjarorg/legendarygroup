---
import { siteMessages as s, webMessages } from '@lg/i18n';
import Base from '../layouts/Base.astro';
---

<Base title={`${s.notFoundTitle} — ${webMessages.landing.brand}`} description={s.seoDescription} noindex>
  <main id="main" class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center px-4 text-center">
    <h1 class="text-3xl font-bold">{s.notFoundTitle}</h1>
    <a href="/" class="mt-6 rounded-lg bg-primary px-5 py-3 font-semibold text-primary-text">{s.notFoundHome}</a>
  </main>
</Base>
