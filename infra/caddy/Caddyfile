# Legendary Group — kirish nuqtasi (T-011, 06 §1). Tizim bitta hostda (APP_DOMAIN), yo'llar bilan:
#   /api/*        → api:3000        /bot/webhook → bot:3002
#   /app/*        → Mini App statik  /, /verify/* → web panel statik (SPA)
# SITE_DOMAIN (apex) — markazning tashrif sayti (T-503, /srv/site), www → apex; LEGACY_DOMAIN — eski manzil.
# TLS — avtomatik (Let's Encrypt). `/internal/*` (bot ↔ api) va Bull Board tashqariga CHIQMAYDI.
# Majburiy env (yashirin standart yo'q): APP_DOMAIN, SITE_DOMAIN, LEGACY_DOMAIN. ACME email yo'q — Let's Encrypt 2025-yildan
# muddat eslatmalarini yubormaydi; hisob emailsiz ro'yxatdan o'tadi (shaxsiy ma'lumot ketmaydi).
{
	# Admin API o'chiq — konfiguratsiyani tarmoqdan o'zgartirib bo'lmaydi.
	admin off
	log {
		output stdout
		format json
	}
}

# SPA: hash'li asset'lar — uzoq kesh, index.html — har doim yangi; noma'lum yo'l → index.html.
(spa) {
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# Faqat konteyner ichidagi healthcheck uchun (port publish qilinmaydi).
:8080 {
	bind 127.0.0.1
	respond /healthz 200
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Caddy mijozdan kelgan X-Forwarded-For'ni tashlab, o'zinikini qo'yadi (ishonchli proksi
	# ro'yxati yo'q) — API'dagi `trustProxy` shu sababli xavfsiz (rate limit IP bo'yicha).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Panel va Mini App qidiruvda chiqmaydi — Google'da faqat sayt (SITE_DOMAIN).
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	# Metrikalar (xotira, biznes navbatlari) — faqat Docker tarmog'idan (`api:3000`), tashqariga yopiq.
	handle /api/health/metrics {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /bot/webhook {
		reverse_proxy bot:3002
	}

	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/miniapp
		# Telegram ichida iframe'da ochiladi (web.telegram.org) — faqat Telegram ramka qila oladi.
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org"
		import spa
	}

	handle {
		root * /srv/web
		header X-Frame-Options "DENY"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		import spa
	}
}

# Tashrif sayti (T-503, `apps/site` — statik Astro). Apex'da faqat saytga kerakli ochiq API
# (kurslar, kontaktlar, ariza) — bir xil origin, CORS yo'q; panel API'si apex'da yopiq.
# HSTS bu yerda YO'Q: `includeSubDomains` apex'da eskiz'dagi webmail/ftp subdomenlarini buzadi.
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Frame-Options "DENY"
		-Server
	}

	@siteApi path /api/public/* /api/settings/public
	handle @siteApi {
		reverse_proxy api:3000
	}
	handle /api/* {
		respond 404
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Allow: /
			Disallow: /api/
			Sitemap: https://{$SITE_DOMAIN}/sitemap.xml
			TXT 200
	}
	handle /sitemap.xml {
		header Content-Type "application/xml; charset=utf-8"
		respond <<XML
			<?xml version="1.0" encoding="UTF-8"?>
			<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"><url><loc>https://{$SITE_DOMAIN}/</loc></url></urlset>
			XML 200
	}

	# Saytdagi "Tizimga kirish" — panel boshqa hostda.
	redir /kirish https://{$APP_DOMAIN}/login 302

	handle {
		root * /srv/site
		# Astro skripti va uslubi HTML ichida (inline) — sayt foydalanuvchi kontentini HTML sifatida chizmaydi (textContent).
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		@html path / /index.html
		header @html Cache-Control "public, max-age=300"
		try_files {path} {path}.html
		file_server
	}

	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} 308
}

# Eski manzil — yo'l saqlangan holda yangi hostga (eski taklif/chek havolalari ishlashda davom etadi).
{$LEGACY_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} 308
}
