# Deploy o'zgaruvchilari (T-011). Haqiqiy fayl serverda (/etc/lg/<muhit>.env, 0600), git'da EMAS;
# qiymatlar SSM Parameter Store'dan yoziladi (T-012/T-014). Hammasi majburiy — standart yo'q.

# --- Image
LG_REGISTRY=123456789012.dkr.ecr.eu-central-1.amazonaws.com
LG_TAG=git-sha-yoki-semver

# --- Muhit
NODE_ENV=staging            # staging | production
LOG_LEVEL=info
APP_DOMAIN=staging.example.uz
ACME_EMAIL=admin@example.uz

# --- Baza: ilova (cheklangan login) va migratsiya (jadval egasi) alohida
APP_DB_LOGIN=lg_api
DATABASE_URL=postgres://lg_api:APP_DB_PASSWORD@postgres:5432/legendary
MIGRATION_DATABASE_URL=postgres://lg_owner:POSTGRES_PASSWORD@postgres:5432/legendary

# --- Faqat staging (Postgres konteynerda; prod'da RDS — bular kerak emas)
POSTGRES_USER=lg_owner
POSTGRES_PASSWORD=
POSTGRES_DB=legendary
APP_DB_PASSWORD=

# --- Sirlar (openssl rand -hex 32)
INTERNAL_API_TOKEN=
JWT_ACCESS_SECRET=
TOTP_ENCRYPTION_KEY=
BULL_BOARD_USER=board
BULL_BOARD_PASSWORD=

# --- Telegram (har muhit uchun alohida bot — BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_WEBHOOK_SECRET=

# --- S3 (kalitlar berilmaydi — EC2 IAM roli)
S3_REGION=eu-central-1
S3_BUCKET_FILES=lg-staging-files
